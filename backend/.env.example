# Leto SM Dashboard — Example Environment

# Ozon Seller API (Leto SM account)
OZON_SELLER_CLIENT_ID=your_client_id_here
OZON_SELLER_API_KEY=your_api_key_here

# Ozon Performance API (optional, for ads analytics)
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=

# Yandex Disk token (for image hosting)
YANDEX_DISK_TOKEN=your_yandex_disk_token_here

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard basic auth
DASHBOARD_USER=admin@example.com
DASHBOARD_PASSWORD=change_me

# Stock monitoring threshold
STOCK_THRESHOLD=10

# Data directories (relative to backend/)
DATA_DIR=./data
UPLOADS_DIR=./uploads

# CORS origins
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Logging
LOG_LEVEL=INFO
